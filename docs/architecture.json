      "column": 0,
      "level": "external",
      "title": "Developer or CI",
      "lines": [
        "runs the command line;",
        "the same seed prints the",
        "same lines"
      ]
    },
    {
      "id": "scen",
      "column": 1,
      "level": "tested",
      "title": "scenarios, alarms, energy",
      "lines": [
        "4 scenarios on 3 sensors over 270 degrees,",
        "alarm scenario files, an inverter with",
        "batteries, an electrical node, real-time energy"
      ],
      "code": [
        "src/armor_simulator/scenarios.py",
        "src/armor_simulator/cycle.py",
        "src/armor_simulator/solar.py",
        "src/armor_simulator/electrical.py",
        "src/armor_simulator/alarm_scenarios.py",
        "src/armor_simulator/energy.py"
      ]
    },
    {
      "id": "faults",
      "column": 1,
      "level": "tested",
      "title": "faults.py",
      "lines": [
        "7 repeatable faults: 4 keep the",
        "messages valid, 3 break the",
        "contract on purpose"
      ],
      "code": [
        "src/armor_simulator/faults.py"
      ]
    },
    {
      "id": "pub",
      "column": 1,
      "level": "contract",
      "title": "publisher.py",
      "lines": [
        "plain http(s) origin only; a 4xx",
        "stops the run, a 5xx is retried",
        "three times"
      ],
      "code": [
        "src/armor_simulator/publisher.py"
      ]
    },
    {
      "id": "common",
      "column": 2,
