{
  "repo": "ARMOR-SIMULATOR",
  "ecosystem": "armor",
  "tagline": "Plays a radar node, a solar gateway and an electrical node, with faults you can repeat, so the rest of the family works without hardware.",
  "description": "ARMOR-SIMULATOR makes the messages of a radar node, an inverter with its batteries and an electrical node, checks them against ARMOR-COMMON when asked, and prints them or delivers them to ARMOR-SERVER, which ARMOR-STUDIO and the phone app then show.",
  "columns": [
    "WHO RUNS IT",
    "THIS REPOSITORY",
    "WHERE THE MESSAGES GO"
  ],
